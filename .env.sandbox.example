# .env para entorno sandbox (valores dummy — Alertmanager levanta pero no envía a Slack real)
# Copiar como .env en la EC2 antes de correr docker compose.
# Para producción real, reemplazar SLACK_WEBHOOK_URL con un webhook válido.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=dwh
POSTGRES_PASSWORD=dwh
PRODUCCION_SOURCE_URL=<url_csv_produccion>
POZOS_SOURCE_URL=<url_csv_pozos>
DATA_PIPELINE_RETRIES=3
DATA_PIPELINE_RETRY_BACKOFF_SECONDS=30
METABASE_ADMIN_EMAIL=admin@demo.com
METABASE_ADMIN_PASSWORD=Admin1234!

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/DUMMY/DUMMY/DUMMY000000000000
