# localhost para comandos desde el host (ej: python -m extract.load_to_bronze).
# Los contenedores (Dagster) se conectan a postgres:5432 (override en docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=warehouse
POSTGRES_USER=dwh
POSTGRES_PASSWORD=dwh
POSTGRES_CONNECT_TIMEOUT=3
PRODUCCION_SOURCE_URL=http://datos.energia.gob.ar/dataset/c846e79c-026c-4040-897f-1ad3543b407c/resource/b5b58cdc-9e07-41f9-b392-fb9ec68b0725/download/produccin-de-pozos-de-gas-y-petrleo-no-convencional.csv
POZOS_SOURCE_URL=http://datos.energia.gob.ar/dataset/c846e79c-026c-4040-897f-1ad3543b407c/resource/cbfa4d79-ffb3-4096-bab5-eb0dde9a8385/download/listado-de-pozos-cargados-por-empresas-operadoras.csv
DATA_PIPELINE_RETRIES=3
DATA_PIPELINE_RETRY_BACKOFF_SECONDS=30
DATA_LOAD_BATCH_SIZE=5000
# Vacío = sin tracking (ml/train.py y la API caen al fallback local en ml_artifacts/).
# Los contenedores (api, dagster) usan http://mlflow:5000 por default (ver docker-compose.yml).
# Para scripts corridos desde el host (ej: retrain-model.sh, drift-check) usar http://localhost:5000.
MLFLOW_TRACKING_URI=
MLFLOW_MODEL_NAME=oilgas_forecaster
MLFLOW_MODEL_ALIAS=champion
ML_ARTIFACTS_DIR=ml_artifacts
LOCAL_MODEL_FALLBACK_PATH=
LOCAL_MODEL_FALLBACK_ENABLED=true
METABASE_ADMIN_EMAIL=martinbianchi@udesa.edu.ar
METABASE_ADMIN_PASSWORD=Admin1234!
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXX/XXXXXXXX/XXXXXXXX
